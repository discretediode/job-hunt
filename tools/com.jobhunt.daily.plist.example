<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobhunt.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOURNAME/jobhunt/tools/daily_run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOURNAME/jobhunt</string>

  <!-- Primary trigger: run as soon as you are on the machine, at login or boot.
       The script's once-per-day stamp means repeated logins do not re-run it. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Safety net for the common laptop case: a Mac that sleeps rather than shuts
       down never fires RunAtLoad again. launchd runs a calendar entry missed
       during sleep on the next wake, so these catch a day where you opened the
       lid instead of booting. Off-the-hour on purpose. Each one hits the
       once-per-day guard and exits immediately if the day already ran. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>57</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>13</integer>
      <key>Minute</key><integer>13</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>18</integer>
      <key>Minute</key><integer>41</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/YOURNAME/jobhunt/applications/_logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOURNAME/jobhunt/applications/_logs/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
